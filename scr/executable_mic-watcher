#!/usr/bin/env python3
from pulsectl import Pulse, PulseLoopStop
import sys
import subprocess

# Adapt to your use-case
last_values = {}
last_mutes = {}

with Pulse() as pulse:
  def callback(ev):
    raise PulseLoopStop
  try:
    pulse.event_mask_set('source')
    pulse.event_callback_set(callback)
    for source_id, source in enumerate(pulse.source_list()):
      last_values[source_id] = round(source.volume.value_flat * 100)
      last_mutes[source_id] = source.mute == 1
    while True:
      pulse.event_listen()
      values = {}
      mutes = {}
      for source_id, source in enumerate(pulse.source_list()):
        value = round(source.volume.value_flat * 100)
        mute = source.mute == 1
        if not(source_id in last_values) or value != last_values[source_id] or mute != last_mutes[source_id]:
          print(value, end='')
          if mute:
            print('!')
          else:
            print('')
          last_values[source_id] = value
          last_mutes[source_id] = mute
      sys.stdout.flush()
  except:
    pass
