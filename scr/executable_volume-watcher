#!/usr/bin/env python3
from pulsectl import Pulse, PulseLoopStop
import sys
import subprocess

# Adapt to your use-case
last_values = {}
last_mutes = {}

with Pulse() as pulse:
  def callback(ev):
    raise PulseLoopStop
  try:
    pulse.event_mask_set('sink')
    pulse.event_callback_set(callback)
    for sink_id, sink in enumerate(pulse.sink_list()):
      last_values[sink_id] = round(sink.volume.value_flat * 100)
      last_mutes[sink_id] = sink.mute == 1
    while True:
      pulse.event_listen()
      values = {}
      mutes = {}
      for sink_id, sink in enumerate(pulse.sink_list()):
        value = round(sink.volume.value_flat * 100)
        mute = sink.mute == 1
        if not(sink_id in last_values) or value != last_values[sink_id] or mute != last_mutes[sink_id]:
          print(value, end='')
          if mute:
            print('!')
          else:
            print('')
          last_values[sink_id] = value
          last_mutes[sink_id] = mute
      sys.stdout.flush()
  except:
    pass
